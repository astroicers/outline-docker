# 敏感檔案
.env

# 資料目錄
data/

# SSL 憑證
nginx/certs/

# Let's Encrypt 驗證目錄
nginx/www/

# Keycloak realm 設定：setup.sh 會把真實的 OIDC client secret 寫進去。
# 版控只留 *.json.template（佔位值）；Keycloak 的 import 只吃 *.json，故範本不會被誤匯入。
keycloak/import/*.json

# 執行時生成的設定檔
nginx/conf.d/outline.conf
nginx/conf.d/outline.conf.ssl
nginx/conf.d/outline-temp.conf.tmpl

# 備份檔案
*.backup
*-backup.sql

# Claude Code 本地設定
.claude/

# macOS
.DS_Store

# IDE
.idea/
.vscode/
*.swp
# ASP 治理框架產物（通配，避免每新增一種就漏一個）
.asp-*
